---
const { img, title, text } = Astro.props;
const { BASE_URL } = import.meta.env;
---

<img src={BASE_URL + img} alt="Food" />
<header>
  <h1>{title}</h1>
  <p>{text}</p>
</header>

<style lang="scss">
  img {
    width: 100%;
    aspect-ratio: 16/9;
    border-radius: 0.75rem;
    @media (min-width: 600px) {
      max-width: 1000px;
      display: block;
      margin-inline: auto;
    }
  }
  header {
    h1 {
      padding: 1.5rem 1rem 1rem;
      text-align: center;
      font-size: clamp(1.75rem, 4dvw, 2.75rem);
      text-wrap: balance;
    }
    p {
      text-wrap: balance;
      text-align: justify;
      padding: 0 1rem 1.5rem;
    }
  }
</style>
